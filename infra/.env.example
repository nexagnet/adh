# Sao chép file này thành ".env" rồi đổi giá trị. KHÔNG đưa file .env vào git.

# ---- Dùng chung (dev và chạy thật) ----
DB_PASSWORD=doi-mat-khau-co-so-du-lieu
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=doi-mat-khau-quan-tri

# ---- Chỉ khi chạy ứng dụng trực tiếp trên máy (không dùng docker-compose.prod.yml) ----
DB_URL=jdbc:postgresql://localhost:5432/crm
DB_USER=crm

# ---- Chạy thật: docker-compose.prod.yml ----
# Tên miền đã trỏ về IP máy chủ (ví dụ chamsoc.cuahang.vn). Caddy tự lấy chứng chỉ HTTPS.
APP_DOMAIN=chamsoc.example.vn
APP_SHOP_NAME=Tên cửa hàng
# Số điện thoại cửa hàng hiện trên trang khách bấm link (có thể để trống).
APP_SHOP_PHONE=
# Gửi thật qua dịch vụ bên ngoài: để false. Hiện chưa có bộ gửi SMS/ZBS nào được cài.
APP_SENDING_ENABLED=false

# ---- Sao lưu: backup.sh (xem docs/RUNBOOK.md) ----
# Thư mục lưu bản sao lưu trên máy chủ và số ngày giữ lại.
BACKUP_DIR=/var/backups/adh
KEEP_DAYS=14
# (Khuyến nghị) khóa công khai age để mã hóa bản sao lưu. Để trống = không mã hóa.
BACKUP_AGE_RECIPIENT=
# (Khuyến nghị) lệnh chép bản sao lưu ra NGOÀI máy chủ, nhận đường dẫn file làm tham số cuối. Ví dụ:
# BACKUP_REMOTE_CMD=rclone copy --no-traverse
BACKUP_REMOTE_CMD=
