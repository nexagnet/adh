# Sao chép file này thành ".env" rồi đổi giá trị. KHÔNG đưa file .env vào git.

# ---- Dùng chung (dev và chạy thật) ----
DB_PASSWORD=doi-mat-khau-co-so-du-lieu
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=doi-mat-khau-quan-tri

# ---- Chỉ khi chạy ứng dụng trực tiếp trên máy (không dùng docker-compose.prod.yml) ----
DB_URL=jdbc:postgresql://localhost:5432/crm
DB_USER=crm

# ---- Chạy thật: docker-compose.prod.yml ----
# Tên miền đã trỏ về IP máy chủ (ví dụ chamsoc.cuahang.vn). Caddy tự lấy chứng chỉ HTTPS.
APP_DOMAIN=chamsoc.example.vn
APP_SHOP_NAME="Tên cửa hàng"
# Số điện thoại cửa hàng hiện trên trang khách bấm link (có thể để trống).
APP_SHOP_PHONE=
# Gửi thật qua dịch vụ bên ngoài: để false. Đường mời hiện dùng là Zalo, mẹ gửi tay; SMS/ZBS chưa dùng.
APP_SENDING_ENABLED=false

# ---- Sao lưu: backup.sh (xem docs/RUNBOOK.md) ----
# Thư mục lưu bản sao lưu trên máy chủ và số ngày giữ lại.
BACKUP_DIR=/var/backups/adh
KEEP_DAYS=14
# (Khuyến nghị) khóa công khai age để mã hóa bản sao lưu. Để trống = không mã hóa.
BACKUP_AGE_RECIPIENT=
# (Khuyến nghị) lệnh chép bản sao lưu ra NGOÀI máy chủ, nhận đường dẫn file làm tham số cuối. Ví dụ:
# BACKUP_REMOTE_CMD=rclone copy --no-traverse
BACKUP_REMOTE_CMD=

# ---- Máy chủ dùng chung: docker-compose.shared.yml + deploy.sh (xem docs/RUNBOOK.md, mục B.2b) ----
# Cổng nội bộ trên máy chủ (chỉ 127.0.0.1). Đổi nếu 8081 đã bị dùng.
ADH_HOST_PORT=8081
# Địa chỉ công khai ứng dụng dùng khi tạo link mời. Chưa có tên miền thì để mặc định, KHÔNG in giấy QR.
APP_PUBLIC_BASE_URL=https://adh.invalid
# (Tuỳ chọn) ghi đè tùy chọn Java của bản dùng chung. Mặc định: -Xms96m -Xmx320m
# ADH_JAVA_OPTS=

# ---- Bản đồ và thời tiết (xem docs/RUNBOOK.md, mục 5d) ----
# Bật lớp thời tiết chạy trên Bản đồ khách (dự báo MET Norway, miễn phí, chỉ gửi tọa độ tỉnh lỵ). Mặc định tắt.
# APP_WEATHER_ENABLED=true
# (Tuỳ chọn) tên ứng dụng gửi cho MET Norway, nên kèm tên miền hoặc email liên hệ của cửa hàng.
# APP_WEATHER_USER_AGENT=adh-shop-crm/1.0 (liên hệ: ten-mien-cua-hang)

# ---- Bộ nối Zalo không chính thức (D16, docs/ADR-0002 và docs/HUONG-DAN-THU-ZALO-TU-DONG.md). MẶC ĐỊNH TẮT ----
# Trái điều khoản Zalo, tài khoản phụ có thể bị khóa. Chỉ bật sau khi đọc hướng dẫn. Cần CẢ BA: cờ dưới đây, profile Docker,
# và chọn nấc ở trang quản trị "Zalo tài khoản phụ".
# APP_ZALO_AUTO_ENABLED=true
# COMPOSE_PROFILES=zalo-auto
# Khóa chung giữa ứng dụng và cầu nối (chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 24).
# APP_ZALO_BRIDGE_KEY=
# Khóa mã hóa phiên Zalo, 64 ký tự hex (openssl rand -hex 32). GIỮ RIÊNG, không để trong bản sao lưu.
# ZALO_SESSION_KEY=
# Mã Zalo (chữ số) của TÀI KHOẢN PHỤ. Tài khoản khác đăng nhập sẽ bị từ chối.
# ZALO_ACCOUNT_ID=
# Trần cứng số người thêm mỗi ngày (trang quản trị chỉ chỉnh được đến mức này). Mặc định 100.
# APP_ZALO_AUTO_MAX_DAILY=300
# Chế độ thử: để trống/false = chỉ liên hệ các số thử khai báo ở trang Zalo (an toàn, khách thật không bị chạm). CHỈ đặt true khi đã thử xong
# và quyết định nhắn khách thật (rồi tạo lại container app).
# APP_ZALO_LIVE=false
# Đọc đối chiếu lời mời và giữ phiên chỉ đọc sau lỗi quá giờ chờ. Bật riêng ở môi trường thử.
# APP_ZALO_RECONCILE_ENABLED=false
# BRIDGE_FRIEND_RECONCILE_ENABLED=false
# BRIDGE_FRIEND_RECONCILE_ENABLED_2=false
# Mã lỗi Zalo đã thấy khi chạy thật và biết chắc là lỗi riêng một người, cách nhau bằng dấu phẩy. Mặc định rỗng: lỗi lạ thì dừng.
# ZALO_PERSON_ERROR_CODES=
# (Tùy chọn) địa chỉ https nhận tin báo khi tài khoản phụ có dấu hiệu bị hạn chế, bị đăng xuất hoặc cầu nối mất (POST văn bản thuần, ví dụ một chủ đề ntfy.sh bí mật).
# Để trống = cảnh báo chỉ hiện trên trang quản trị. Tin báo không chứa dữ liệu khách.
# APP_ALERT_WEBHOOK_URL=
# (Thiếu một trong ba khóa trên thì cầu nối KHÔNG khởi động, báo lỗi rõ trong log; ứng dụng chính vẫn chạy.)

# ---- NHIỀU tài khoản Zalo phụ cố định chạy song song (D23, docs/HUONG-DAN-NHIEU-TAI-KHOAN-ZALO.md). MẶC ĐỊNH TẮT ----
# Mỗi tài khoản có cầu nối riêng, khóa riêng. Tài khoản thứ hai CÙNG máy chủ: đặt COMPOSE_FILE=docker-compose.shared.yml:docker-compose.zalo-2.yml
# và COMPOSE_PROFILES=zalo-auto,zalo-bridge-2 (deploy.sh, backup.sh và cron tự deploy đều đọc hai biến này; tệp đầu phải là docker-compose.shared.yml) rồi các khóa dưới đây. Tài khoản thứ hai Ở MÁY CHỦ KHÁC: dùng docker-compose.bridge-only.yml ở máy đó; ở máy chính vẫn dùng
# COMPOSE_FILE như trên nhưng COMPOSE_PROFILES=zalo-auto và đặt ZALO_BRIDGE_2_URL=http://<địa-chỉ-đường-hầm>:3100 (APP_ZALO_BRIDGE_KEY_2 là khóa chung của cầu nối đó).
# ZALO_BRIDGE_2_URL=
# APP_ZALO_BRIDGE_KEY_2=
# ZALO_SESSION_KEY_2=
# ZALO_ACCOUNT_ID_2=
# Công tắc xếp lịch nhiều tài khoản. Tài khoản mới chỉ được xếp lịch sau khi được xác nhận và bật riêng ở /zalo.
# APP_ZALO_MULTI_ENABLED=false
# Tài khoản 2 mặc định chỉ liên hệ số thử, kể cả khi tài khoản 1 đang chạy thật.
# APP_ZALO_LIVE_2=false

# ---- Tự cập nhật bằng cron: auto-deploy.sh (xem docs/RUNBOOK.md, mục 2c). Đều tùy chọn ----
# ADH_AUTO_MIN_FREE_MB=250
# ADH_AUTO_MIN_DISK_MB=1500
# ADH_AUTO_MAX_ATTEMPTS=3
# Chỉ cần nếu repo trên GitHub là riêng tư (token chỉ đọc Actions); repo công khai thì bỏ trống.
# ADH_AUTO_GITHUB_TOKEN=
